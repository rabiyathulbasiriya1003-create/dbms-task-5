\pard\sa200\sl276\slmult1\f0\fs22\lang9 CREATE DATABASE IF NOT EXISTS OrderManagementDB;\par
USE OrderManagementDB;\par
CREATE TABLE IF NOT EXISTS Customers (\par
    Customer_ID INT PRIMARY KEY,\par
    Customer_Name VARCHAR(100) NOT NULL,\par
    Email VARCHAR(100) UNIQUE NOT NULL\par
);\par
CREATE TABLE IF NOT EXISTS Orders (\par
    Order_ID INT PRIMARY KEY,\par
    Customer_ID INT NOT NULL,\par
    Order_Date DATE NOT NULL,\par
    Total_Amount DECIMAL(10,2) NOT NULL CHECK (Total_Amount > 0),\par
    Order_Status VARCHAR(20) NOT NULL,\par
    FOREIGN KEY (Customer_ID) REFERENCES Customers(Customer_ID)\par
);\par
CREATE TABLE IF NOT EXISTS Payment (\par
    Payment_ID INT PRIMARY KEY,\par
    Order_ID INT NOT NULL UNIQUE,\par
    Payment_Date DATE NOT NULL,\par
    Payment_Mode VARCHAR(30) NOT NULL,\par
    Payment_Status VARCHAR(20) NOT NULL DEFAULT 'Pending',\par
    Transaction_Amount DECIMAL(10,2) NOT NULL\par
        CHECK (Transaction_Amount > 0),\par
\par
    FOREIGN KEY (Order_ID) REFERENCES Orders(Order_ID),\par
\par
    CHECK (Payment_Mode IN (\par
        'UPI', 'Credit Card', 'Debit Card',\par
        'Net Banking', 'Cash on Delivery'\par
    )),\par
\par
    CHECK (Payment_Status IN (\par
        'Pending', 'Success', 'Failed'\par
    ))\par
);\par
INSERT INTO Customers VALUES\par
(1, 'Arun', 'arun@gmail.com'),\par
(2, 'Priya', 'priya@gmail.com'),\par
(3, 'Kumar', 'kumar@gmail.com'),\par
(4, 'Divya', 'divya@gmail.com'),\par
(5, 'Ravi', 'ravi@gmail.com');\par
INSERT INTO Orders VALUES\par
(101, 1, '2026-10-20', 1500.00, 'Delivered'),\par
(102, 2, '2026-10-21', 2500.00, 'Processing'),\par
(103, 3, '2026-10-22', 1000.00, 'Pending'),\par
(104, 4, '2026-10-23', 3000.00, 'Processing'),\par
(105, 5, '2026-10-24', 2000.00, 'Pending');\par
INSERT INTO Payment VALUES\par
(1, 101, '2026-10-20', 'UPI', 'Success', 1500.00),\par
(2, 102, '2026-10-21', 'Credit Card', 'Failed', 2500.00),\par
(3, 103, '2026-10-22', 'Debit Card', 'Pending', 1000.00),\par
(4, 104, '2026-10-23', 'Net Banking', 'Success', 3000.00),\par
(5, 105, '2026-10-24', 'Cash on Delivery', 'Pending', 2000.00);\par
SELECT * FROM Payment;\par
SELECT * FROM Payment\par
WHERE Payment_Status = 'Success';\par
SELECT * FROM Payment\par
WHERE Payment_Status = 'Failed';\par
SELECT * FROM Payment\par
WHERE Payment_Status = 'Pending';\par
SELECT * FROM Payment\par
WHERE Order_ID = 101;\par
UPDATE Payment\par
SET Payment_Status = 'Success'\par
WHERE Payment_ID = 2;\par
UPDATE Payment\par
SET Payment_Mode = 'UPI'\par
WHERE Payment_ID = 3;\par
SELECT Payment_Status, COUNT(*) AS Total_Transactions\par
FROM Payment\par
WHERE Payment_Status IN ('Success', 'Failed')\par
GROUP BY Payment_Status;\par
SELECT Payment_Mode, COUNT(*) AS Total_Transactions\par
FROM Payment\par
GROUP BY Payment_Mode;\par
SELECT Payment_Mode, COUNT(*) AS Total_Transactions\par
FROM Payment\par
GROUP BY Payment_Mode\par
ORDER BY Total_Transactions DESC\par
LIMIT 1;\par
SELECT SUM(Transaction_Amount) AS Total_Revenue\par
FROM Payment\par
WHERE Payment_Status = 'Success';\par
SELECT Payment_Mode,\par
       SUM(Transaction_Amount) AS Revenue\par
FROM Payment\par
WHERE Payment_Status = 'Success'\par
GROUP BY Payment_Mode;\par
SELECT AVG(Transaction_Amount) AS Average_Amount\par
FROM Payment;\par
SELECT C.Customer_ID, C.Customer_Name,\par
       O.Order_ID, O.Order_Date,\par
       P.Payment_Mode, P.Payment_Status,\par
       P.Transaction_Amount\par
FROM Customers C\par
JOIN Orders O ON C.Customer_ID = O.Customer_ID\par
JOIN Payment P ON O.Order_ID = P.Order_ID\par
ORDER BY C.Customer_ID;\par
SELECT C.Customer_Name, C.Email,\par
       O.Order_ID, O.Order_Date, O.Order_Status,\par
       P.Payment_ID, P.Payment_Date,\par
       P.Payment_Mode, P.Payment_Status,\par
       P.Transaction_Amount\par
FROM Customers C\par
JOIN Orders O ON C.Customer_ID = O.Customer_ID\par
JOIN Payment P ON O.Order_ID = P.Order_ID;\par
SELECT Payment_Status, COUNT(*) AS Total\par
FROM Payment\par
GROUP BY Payment_Status;\par
SELECT O.Order_ID, C.Customer_Name,\par
       P.Payment_Mode, P.Payment_Status,\par
       P.Transaction_Amount\par
FROM Orders O\par
JOIN Customers C ON O.Customer_ID = C.Customer_ID\par
JOIN Payment P ON O.Order_ID = P.Order_ID\par
WHERE P.Payment_Status IN ('Failed', 'Pending');\par
SELECT O.Order_ID, C.Customer_Name, O.Total_Amount\par
FROM Orders O\par
JOIN Customers C ON O.Customer_ID = C.Customer_ID\par
LEFT JOIN Payment P ON O.Order_ID = P.Order_ID\par
WHERE P.Payment_ID IS NULL;\par
DESCRIBE Payment;\par
\par

